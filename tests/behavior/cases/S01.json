      "path": "AGENTS.md"
    },
    {
      "kind": "path_exists",
      "path": "CLAUDE.md"
    },
    {
      "kind": "path_exists",
      "path": "GEMINI.md"
    },
    {
      "kind": "path_exists",
      "path": "draft.md"
    },
    {
      "kind": "path_absent",
      "path": "src"
